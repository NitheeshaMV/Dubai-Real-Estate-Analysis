{
  "name": "Dubai Property 2026 — Navy",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F5F8",
  "backgroundNeutral": "#E2E6EC",
  "tableAccent": "#12325B",
  "good": "#0ca30c",
  "neutral": "#eda100",
  "bad": "#d03b3b",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#12325B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E6EC"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 8,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 92
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#9CA3AF"
              }
            },
            "fontSize": 8,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDF0F4"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#374151"
              }
            },
            "fontSize": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9EDF2"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#12325B"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12325B"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "alignment": "Left",
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F8FB"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDF0F4"
              }
            },
            "gridVertical": false,
            "rowPadding": 5,
            "outlineColor": {
              "solid": {
                "color": "#E2E6EC"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 8,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1E4677"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#2A5A92"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#12325B"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangleRounded",
            "roundEdge": 6
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    }
  }
}